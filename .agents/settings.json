{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(cargo *)",
      "Bash(.agents/scripts/*)",
      "Bash(xcodegen *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git push origin agent/*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(cd *)"
    ],
    "deny": [
      "Edit(**/.claude/**)",
      "Edit(**/.agents/**)",
      "Edit(**/.github/**)",
      "Edit(core/**)",
      "Edit(api/**)",
      "Read(**/.env)",
      "Bash(git push*main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(git restore*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.agents/HUMAN.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/stop-gate.sh" }
        ]
      }
    ]
  }
}
