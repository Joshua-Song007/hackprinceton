{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(swift *)",
      "Bash(.agents/scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git fetch*)",
      "Bash(git ls-remote*)",
      "Bash(git merge origin/main*)",
      "Bash(git merge --abort)",
      "Bash(git push origin agent/*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push --set-upstream origin agent/*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * show*)",
      "Bash(uname*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(cd *)"
    ],
    "deny": [
      "Edit(**/.claude/**)",
      "Edit(**/.agents/**)",
      "Edit(**/.github/**)",
      "Edit(**/CLAUDE.md)",
      "Read(**/.env)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push* +*)",
      "Bash(git push*--delete*)",
      "Bash(git -C * push*)",
      "Bash(gh *)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(git restore*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.agents/HUMAN.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/stop-gate.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
