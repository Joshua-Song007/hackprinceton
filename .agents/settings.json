{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(swift *)",
      "Bash(.agents/scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git merge origin/main*)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(cd *)"
    ],
    "deny": [
      "Edit(**/.claude/**)",
      "Edit(**/.agents/**)",
      "Edit(**/.github/**)",
      "Edit(**/CLAUDE.md)",
      "Read(**/.env)",
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "Bash(gh *)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(git restore*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.agents/HUMAN.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/stop-gate.sh" }
        ]
      }
    ]
  }
}
