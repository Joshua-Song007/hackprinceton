{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit",
      "Write",
      "Bash(swift *)",
      "Bash(.agents/scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git switch -c agent/*)",
      "Bash(git merge --ff-only origin/main*)",
      "Bash(git worktree *)",
      "Bash(git push origin agent/*)",
      "Bash(git -C * status*)",
      "Bash(git -C * log*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * push origin agent/*)",
      "Bash(gh issue *)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr diff*)",
      "Bash(gh label *)",
      "Bash(ls*)",
      "Bash(mkdir *)",
      "Bash(cd *)"
    ],
    "deny": [
      "Edit(**/.claude/overview.md)",
      "Edit(**/.claude/instructions.md)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/.agents/**)",
      "Edit(**/.github/**)",
      "Read(**/.env)",
      "Bash(git push*main*)",
      "Bash(git -C * push*main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(gh pr merge*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Bash(git restore*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(**/.agents/HUMAN.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/scripts/stop-gate.sh" }
        ]
      }
    ]
  }
}
