{
 "version": 1,
 "scenarios": [
  {
   "name": "three phones: start, tag in range, fuse eliminates, last one wins",
   "durationMs": 120000,
   "devices": [
    {
     "name": "Ann",
     "kind": "phone",
     "role": "phone",
     "rules": [
      {
       "on": "holder",
       "when": "data.id == me.id",
       "after": 300,
       "send": {
        "name": "tag",
        "data": {}
       }
      },
      {
       "on": "_welcome",
       "after": 500,
       "send": {
        "name": "start",
        "data": {}
       }
      }
     ],
     "script": [
      {
       "at": 0,
       "every": 1000,
       "until": 120000,
       "send": {
        "name": "pos",
        "data": {
         "x": 0,
         "z": 0,
         "acc": 0.5
        }
       }
      }
     ]
    },
    {
     "name": "Ben",
     "kind": "phone",
     "role": "phone",
     "rules": [
      {
       "on": "holder",
       "when": "data.id == me.id",
       "after": 300,
       "send": {
        "name": "tag",
        "data": {}
       }
      }
     ],
     "script": [
      {
       "at": 0,
       "every": 1000,
       "until": 120000,
       "send": {
        "name": "pos",
        "data": {
         "x": 1,
         "z": 0,
         "acc": 0.5
        }
       }
      }
     ]
    },
    {
     "name": "Cy",
     "kind": "phone",
     "role": "phone",
     "rules": [
      {
       "on": "holder",
       "when": "data.id == me.id",
       "after": 300,
       "send": {
        "name": "tag",
        "data": {}
       }
      }
     ],
     "script": [
      {
       "at": 0,
       "every": 1000,
       "until": 120000,
       "send": {
        "name": "pos",
        "data": {
         "x": 40,
         "z": 0,
         "acc": 0.5
        }
       }
      }
     ]
    }
   ],
   "expect": [
    {
     "by": 1000,
     "device": "Ann",
     "expr": "ev.holder.id"
    },
    {
     "by": 120000,
     "device": "Ann",
     "expr": "ev.winner.id"
    }
   ]
  },
  {
   "name": "stale position: tag is refused with a reason",
   "durationMs": 20000,
   "devices": [
    {
     "name": "Ann",
     "kind": "phone",
     "script": [
      {
       "at": 0,
       "send": {
        "name": "pos",
        "data": {
         "x": 0,
         "z": 0
        }
       }
      },
      {
       "at": 500,
       "send": {
        "name": "start",
        "data": {}
       }
      }
     ],
     "rules": [
      {
       "on": "holder",
       "when": "data.id == me.id",
       "after": 300,
       "send": {
        "name": "tag",
        "data": {}
       }
      }
     ]
    },
    {
     "name": "Ben",
     "kind": "phone",
     "script": [
      {
       "at": 0,
       "send": {
        "name": "pos",
        "data": {
         "x": 1,
         "z": 0
        }
       }
      }
     ],
     "rules": [
      {
       "on": "holder",
       "when": "data.id == me.id",
       "after": 300,
       "send": {
        "name": "tag",
        "data": {}
       }
      }
     ]
    }
   ],
   "expect": [
    {
     "by": 15000,
     "device": "Ann",
     "expr": "ev.tagMissed.reason"
    }
   ]
  }
 ],
 "untested": [
  "gestures: swing threshold lives in the client script and scene.json",
  "real GPS accuracy and sockets"
 ]
}