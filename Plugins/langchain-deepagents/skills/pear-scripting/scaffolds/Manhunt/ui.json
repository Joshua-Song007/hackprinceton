{
  "pearui": 1,
  "route": [
    { "when": "ev.view.phase == 'countdown'", "screen": "countdown" },
    { "when": "ev.view.phase == 'hunt'", "screen": "play" },
    { "when": "ev.view.phase == 'over'", "screen": "over" },
    { "screen": "lobby" }
  ],
  "screens": {
    "lobby": {
      "type": "column",
      "children": [
        { "type": "sensor", "kind": "location", "event": "location", "hz": 1, "id": "loc" },
        { "type": "text", "value": "MANHUNT", "style": { "size": "huge", "tone": "accent" } },
        { "type": "text", "value": "{{ev.view.joined || 0}} players joined. Need 3 and a GPS fix, or tap Start.", "style": { "size": "m", "caps": true } },
        { "type": "list", "items": "ev.view.players", "item": {
          "type": "row", "style": { "card": true }, "children": [
            { "type": "text", "value": "{{item.name}}", "style": { "size": "l" } },
            { "type": "spacer" },
            { "type": "text", "value": "{{item.hasFix && 'GPS ok' || 'no fix'}}", "style": { "size": "s", "mono": true, "tone": "neutral" } }
          ] } },
        { "type": "spacer" },
        { "type": "button", "label": "Start", "action": { "send": "start", "data": {} } }
      ]
    },
    "countdown": {
      "type": "column",
      "children": [
        { "type": "sensor", "kind": "location", "event": "location", "hz": 1, "id": "loc" },
        { "type": "text", "value": "Get ready", "style": { "size": "l", "caps": true, "align": "center" } },
        { "type": "timer", "until": "ev.view.endsAt", "style": { "size": "huge", "align": "center", "mono": true } },
        { "type": "list", "items": "ev.view.players", "item": {
          "type": "column", "if": "item.id == me.id", "children": [
            { "type": "text", "value": "You are a {{item.role}}", "style": { "size": "xl", "align": "center", "tone": "accent" } }
          ] } }
      ]
    },
    "play": {
      "type": "column",
      "style": { "fill": "{{ev.view.alarm && 'bad'}}" },
      "children": [
        { "type": "sensor", "kind": "location", "event": "location", "hz": 1, "id": "loc" },
        { "type": "effect", "id": "catch-haptic", "on": "ev.view.caughtCount", "haptic": "success" },
        { "type": "timer", "until": "ev.view.endsAt", "style": { "size": "xl", "align": "end", "mono": true } },
        { "type": "list", "items": "ev.view.players", "item": {
          "type": "column", "if": "item.id == me.id && item.role == 'hunter'", "children": [
            { "type": "text", "value": "HUNTER", "style": { "size": "l", "caps": true, "tone": "accent" } },
            { "type": "map", "markers": "ev.view.pings", "follow": "me" },
            { "type": "text", "value": "{{ev.view.runnersLeft}} runners left", "style": { "size": "l" } },
            { "type": "text", "value": "Positions refresh every 30 s", "style": { "size": "s", "caps": true } },
            { "type": "spacer" },
            { "type": "button", "label": "TAG", "action": { "send": "tag", "data": {} } }
          ] } },
        { "type": "list", "items": "ev.view.players", "item": {
          "type": "column", "if": "item.id == me.id && item.role == 'runner' && !item.caught", "children": [
            { "type": "text", "value": "RUNNER", "style": { "size": "l", "caps": true, "tone": "accent" } },
            { "type": "spacer" },
            { "type": "text", "value": "{{item.hint}}", "style": { "size": "huge", "align": "center", "tone": "{{item.tone}}" } },
            { "type": "text", "value": "Hunters: {{ev.view.huntersText}}", "style": { "size": "s", "align": "center", "caps": true } }
          ] } },
        { "type": "list", "items": "ev.view.players", "item": {
          "type": "column", "if": "item.id == me.id && item.caught", "children": [
            { "type": "text", "value": "CAUGHT", "style": { "size": "huge", "align": "center", "tone": "bad" } },
            { "type": "text", "value": "{{ev.view.runnersLeft}} runners still free", "style": { "size": "m", "align": "center" } }
          ] } }
      ]
    },
    "over": {
      "type": "column",
      "children": [
        { "type": "text", "value": "{{ev.view.winner == 'hunters' && 'Hunters win' || 'Runners win'}}", "style": { "size": "huge", "tone": "accent", "align": "center" } },
        { "type": "text", "value": "{{ev.view.caughtCount}} caught, {{ev.view.runnersLeft}} escaped", "style": { "size": "l", "align": "center" } },
        { "type": "spacer" },
        { "type": "button", "label": "Back to lobby", "action": { "send": "start", "data": {} } }
      ]
    }
  }
}
