{
 "version": 1,
 "scenarios": [
  {
   "name": "two phones banish all three wraiths: round won",
   "durationMs": 10000,
   "devices": [
    {
     "name": "Ann",
     "kind": "phone",
     "role": "phone",
     "script": [
      { "at": 500, "send": { "name": "banish", "data": { "enemy": "WraithLeft" } } },
      { "at": 800, "send": { "name": "banish", "data": { "enemy": "WraithLeft" } } },
      { "at": 1000, "send": { "name": "banish", "data": { "enemy": "WraithAhead" } } }
     ]
    },
    {
     "name": "Ben",
     "kind": "phone",
     "role": "phone",
     "script": [
      { "at": 900, "send": { "name": "banish", "data": { "enemy": "WraithRight" } } }
     ]
    }
   ],
   "expect": [
    { "by": 3000, "device": "Ann", "expr": "ev.round.state == 'won'" },
    { "by": 3000, "device": "Ben", "expr": "ev.round.state == 'won'" }
   ]
  },
  {
   "name": "three contacts with a live wraith: round lost",
   "durationMs": 10000,
   "devices": [
    {
     "name": "Cat",
     "kind": "phone",
     "role": "phone",
     "script": [
      { "at": 500, "send": { "name": "contact", "data": { "enemy": "WraithAhead" } } },
      { "at": 700, "send": { "name": "contact", "data": { "enemy": "WraithAhead" } } },
      { "at": 900, "send": { "name": "contact", "data": { "enemy": "WraithAhead" } } },
      { "at": 1200, "send": { "name": "banish", "data": { "enemy": "WraithLeft" } } }
     ]
    }
   ],
   "expect": [
    { "by": 3000, "device": "Cat", "expr": "ev.damage.hits == 3" },
    { "by": 3000, "device": "Cat", "expr": "ev.round.state == 'lost'" }
   ]
  }
 ],
 "untested": [
  "client scripts (enemy, player): look-at locking, gestures, haptics need a device",
  "real sockets and the hosted server clock (Deploy/smoke-game.mjs)"
 ]
}
